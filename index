      function calculateResult() {
        const scores = { plan: 0, dev: 0, design: 0, data: 0 };
        answers.forEach((role) => {
          scores[role] += 1;
        });

        const maxScore = Math.max(...Object.values(scores));
        const tied = Object.keys(scores).filter((r) => scores[r] === maxScore);
        let winner = tied[0];

        if (tied.length > 1) {
          const headToHead = { plan: 0, dev: 0, design: 0, data: 0 };
          QUESTIONS.forEach((q, idx) => {
            const rA = q.options[0].role;
            const rB = q.options[1].role;
            if (answers[idx] && tied.includes(rA) && tied.includes(rB)) {
              headToHead[answers[idx]] += 1;
            }
          });
          const maxH2H = Math.max(...tied.map((r) => headToHead[r]));
          const afterH2H = tied.filter((r) => headToHead[r] === maxH2H);

          if (afterH2H.length === 1) {
            winner = afterH2H[0];
          } else {
            for (let i = answers.length - 1; i >= 0; i--) {
              if (afterH2H.includes(answers[i])) {
                winner = answers[i];
                break;
              }
            }
          }
        }

        const orderedRoles = Object.keys(scores).sort((a, b) => {
          if (a === winner) return -1;
          if (b === winner) return 1;
          return scores[b] - scores[a];
        });

        return { primary: ROLE_PROFILES[winner], scores, orderedRoles };
      }

      function updateHeader() {
        if (step === 'start') {
          headerStatus.textContent = '진로 탐색';
          headerStatus.className = 'text-xs sm:text-sm font-medium text-[#6B6185] whitespace-nowrap shrink-0';
        } else if (step === 'question') {
          headerStatus.textContent = `${currentIndex + 1} / ${QUESTIONS.length}`;
          headerStatus.className = 'text-xs sm:text-sm font-semibold text-violet-700 whitespace-nowrap shrink-0 tabular-nums';
        } else {
          headerStatus.textContent = '분석 완료';
          headerStatus.className = 'text-xs sm:text-sm font-medium text-[#6B6185] whitespace-nowrap shrink-0';
        }
      }

      function renderStart() {
        updateHeader();
        appRoot.innerHTML = `
          <section class="w-full max-w-4xl mx-auto animate-fade-up">
            <div class="bg-white rounded-3xl border border-[#E6DEFF] shadow-[0_16px_44px_-16px_rgba(109,40,217,0.14)] p-6 sm:p-10 lg:p-12 space-y-6">
              <div class="space-y-3.5">
                <p class="text-xs sm:text-sm font-medium text-violet-700">
                  대학생 2~4학년 맞춤 · 12개 일상 질문 · 약 2분 소요
                </p>
                <h1 class="text-[1.75rem] sm:text-4xl font-bold text-[#1E1633] leading-[1.25] tracking-tight">
                  나에게 맞는 직무 유형 테스트
                </h1>
                <p class="text-[14.5px] sm:text-base text-[#52486B] leading-[1.7] max-w-2xl">
                  아직 직무가 낯설어도 괜찮아요. 조별과제, 동아리, 아르바이트처럼 익숙한 대학생활 장면 12가지를 고르다 보면 내 일하는 스타일과 딱 맞는 직무, 지금 준비하면 좋은 과목·자격증까지 한눈에 확인할 수 있어요.
                </p>
              </div>

              <div class="pt-5 border-t border-[#F0EBFF] space-y-5">
                <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs sm:text-sm text-[#5B5273]">
                  <span class="font-semibold text-[#1E1633]">분석 유형</span>
                  <span class="text-violet-300">/</span>
                  <span>기획형 PM · 구현형 개발자 · 공감형 디자이너 · 탐구형 데이터 분석가</span>
                </div>

                <button
                  id="startBtn"
                  type="button"
                  class="w-full sm:w-auto min-h-[54px] px-8 py-3.5 rounded-2xl bg-violet-600 hover:bg-violet-700 active:scale-[0.98] text-white font-semibold text-base inline-flex items-center justify-center gap-2 shadow-[0_10px_24px_-8px_rgba(124,58,237,0.55)] transition"
                >
                  <span>시작하기</span>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>
          </section>
        `;

        document.getElementById('startBtn').addEventListener('click', () => {
          answers = [];
          currentIndex = 0;
          step = 'question';
          render();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      function renderQuestion() {
        updateHeader();
        isLocked = false;
        const q = QUESTIONS[currentIndex];
        const total = QUESTIONS.length;
        const progress = ((currentIndex + 1) / total) * 100;
        const prevChoice = answers[currentIndex];

        appRoot.innerHTML = `
          <section class="w-full max-w-2xl mx-auto animate-fade-up">
            <div class="mb-6 sm:mb-8 space-y-3">
              <div class="flex items-center justify-between gap-4">
                <button
                  id="backBtn"
                  type="button"
                  class="min-h-[44px] px-2 -ml-2 inline-flex items-center gap-1.5 text-sm font-medium text-[#5B5273] hover:text-violet-700 rounded-xl"
                >
                  <span aria-hidden="true">←</span>
                  <span>${currentIndex === 0 ? '처음으로' : '이전 질문'}</span>
                </button>
                <div class="text-sm sm:text-base font-bold text-violet-700 tabular-nums">
                  ${currentIndex + 1}/${total}
                </div>
              </div>
              <div class="w-full h-2.5 bg-[#E8E0FF] rounded-full overflow-hidden">
                <div
                  class="h-full bg-violet-600 rounded-full transition-all duration-300"
                  style="width: ${progress}%"
                ></div>
              </div>
            </div>

            <div class="space-y-5 sm:space-y-7">
              <div class="space-y-2 px-1">
                <p class="text-xs sm:text-sm font-semibold text-violet-700">
                  상황 ${currentIndex + 1} · ${q.situation}
                </p>
                <h2 class="text-[1.35rem] sm:text-[1.75rem] font-bold text-[#1E1633] leading-[1.38] tracking-tight">
                  ${q.prompt}
                </h2>
              </div>

              <div class="grid grid-cols-1 gap-3.5 sm:gap-4">
                ${q.options
                  .map((opt, idx) => {
                    const letter = idx === 0 ? 'A' : 'B';
                    const isSelected = prevChoice === opt.role;
                    return `
                      <button
                        type="button"
                        data-idx="${idx}"
                        data-role="${opt.role}"
                        class="choice-btn w-full min-h-[82px] sm:min-h-[96px] text-left rounded-3xl p-4 sm:p-6 border-2 transition-colors flex items-center gap-3.5 sm:gap-5 select-none ${
                          isSelected
                            ? 'bg-[#F3EEFF] border-violet-600 shadow-[0_12px_28px_-12px_rgba(124,58,237,0.35)]'
                            : 'bg-white border-[#E6DEFF] hover:border-violet-400 active:bg-[#F8F5FF] shadow-[0_10px_28px_-14px_rgba(109,40,217,0.12)]'
                        }"
                      >
                        <span
                          class="choice-badge w-9 h-9 sm:w-10 sm:h-10 rounded-full shrink-0 inline-flex items-center justify-center font-bold text-sm transition-colors ${
                            isSelected ? 'bg-violet-600 text-white' : 'bg-[#F3EEFF] text-violet-700'
                          }"
                        >
                          ${isSelected ? '✓' : letter}
                        </span>
                        <span class="text-[15px] sm:text-[1.0625rem] font-medium text-[#1E1633] leading-[1.52]">
                          ${opt.label}
                        </span>
                      </button>
                    `;
                  })
                  .join('')}
              </div>
            </div>
          </section>
        `;

        document.getElementById('backBtn').addEventListener('click', () => {
          if (isLocked) return;
          if (currentIndex > 0) {
            currentIndex -= 1;
          } else {
            step = 'start';
          }
          render();
        });

        document.querySelectorAll('.choice-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            if (isLocked) return;
            isLocked = true;

            const role = btn.getAttribute('data-role');
            btn.classList.remove('bg-white', 'border-[#E6DEFF]');
            btn.classList.add(
              'bg-[#F3EEFF]',
              'border-violet-600',
              'animate-choice-bounce',
              'shadow-[0_12px_28px_-12px_rgba(124,58,237,0.35)]'
            );
            const badge = btn.querySelector('.choice-badge');
            badge.classList.remove('bg-[#F3EEFF]', 'text-violet-700');
            badge.classList.add('bg-violet-600', 'text-white');
            badge.textContent = '✓';

            answers[currentIndex] = role;

            setTimeout(() => {
              if (currentIndex + 1 < QUESTIONS.length) {
                currentIndex += 1;
              } else {
                step = 'result';
                window.scrollTo({ top: 0, behavior: 'smooth' });
              }
              render();
            }, 340);
          });
        });
      }

      function renderResult() {
        updateHeader();
        const { primary, scores, orderedRoles } = calculateResult();

        appRoot.innerHTML = `
          <section class="w-full max-w-4xl mx-auto animate-fade-up">
            <div class="bg-white rounded-3xl border border-[#E6DEFF] shadow-[0_18px_48px_-16px_rgba(109,40,217,0.16)] p-5 sm:p-10 space-y-7 sm:space-y-8">
              <div class="space-y-3">
                <p class="text-xs sm:text-sm font-semibold text-violet-700">
                  나와 가장 잘 어울리는 직무 유형
                </p>
                <h1 class="text-[1.75rem] sm:text-4xl font-bold text-[#1E1633] tracking-tight">
                  ${primary.title}
                </h1>
                <p class="text-base sm:text-lg font-semibold text-violet-700">
                  “${primary.nickname}”
                </p>
                <p class="text-[15px] sm:text-base text-[#4B4263] leading-[1.72] pt-1">
                  ${primary.description}
                </p>
              </div>

              <div class="pt-7 border-t border-[#EFEAFF] space-y-5">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                  <h2 class="text-lg sm:text-xl font-bold text-[#1E1633]">
                    지금 준비하면 좋은 자격증·과목 3가지
                  </h2>
                  <span class="text-xs sm:text-sm text-[#6B6185]">
                    전공과 상관없이 대학생 때 가볍게 시작하기 좋아요
                  </span>
                </div>

                <ol class="divide-y divide-[#F2EDFF]">
                  ${primary.recommendations
                    .map(
                      (item, idx) => `
                        <li class="py-4 first:pt-1 last:pb-1 flex items-start gap-4">
                          <span class="text-base sm:text-lg font-bold text-violet-600 tabular-nums shrink-0 pt-0.5">
                            0${idx + 1}.
                          </span>
                          <div class="space-y-1">
                            <h3 class="text-[15px] sm:text-base font-bold text-[#1E1633]">
                              ${item.title}
                            </h3>
                            <p class="text-sm text-[#5B5273] leading-[1.6]">${item.note}</p>
                          </div>
                        </li>
                      `
                    )
                    .join('')}
                </ol>
              </div>

              <div class="pt-7 border-t border-[#EFEAFF] space-y-4">
                <h2 class="text-base sm:text-lg font-bold text-[#1E1633]">
                  내 일하는 스타일 분포
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3.5">
                  ${orderedRoles
                    .map((key) => {
                      const prof = ROLE_PROFILES[key];
                      const score = scores[key];
                      const pct = Math.round((score / 6) * 100);
                      const isWinner = key === primary.key;
                      return `
                        <div class="space-y-1.5">
                          <div class="flex items-center justify-between text-sm">
                            <span class="${isWinner ? 'font-bold text-violet-700' : 'font-medium text-[#4B4263]'}">
                              ${prof.title}
                            </span>
                            <span class="tabular-nums text-xs sm:text-sm ${isWinner ? 'font-bold text-violet-700' : 'font-medium text-[#6B6185]'}">
                              ${score} / 6회 선택
                            </span>
                          </div>
                          <div class="w-full h-2 bg-[#F2EDFF] rounded-full overflow-hidden">
                            <div
                              class="h-full rounded-full ${isWinner ? 'bg-violet-600' : 'bg-violet-300'}"
                              style="width: ${pct}%"
                            ></div>
                          </div>
                        </div>
                      `;
                    })
                    .join('')}
                </div>
              </div>

              <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                <button
                  id="restartBtn"
                  type="button"
                  class="flex-1 min-h-[54px] px-6 py-3.5 rounded-2xl bg-violet-600 hover:bg-violet-700 active:scale-[0.98] text-white font-semibold text-base inline-flex items-center justify-center gap-2 shadow-[0_10px_24px_-8px_rgba(124,58,237,0.5)] transition"
                >
                  <span>다시 하기</span>
                </button>
                <button
                  id="copyBtn"
                  type="button"
                  class="min-h-[54px] px-6 py-3.5 rounded-2xl bg-[#F5F1FF] hover:bg-[#ECE4FF] active:scale-[0.98] text-violet-800 font-semibold text-sm sm:text-base inline-flex items-center justify-center gap-2 transition"
                >
                  <span>결과 요약 복사</span>
                </button>
              </div>
            </div>
          </section>
        `;

        document.getElementById('restartBtn').addEventListener('click', restartQuiz);
        const copyBtn = document.getElementById('copyBtn');
        copyBtn.addEventListener('click', async () => {
          const text = `[나에게 맞는 직무 유형 테스트]\n내 유형: ${primary.title}\n"${primary.nickname}"\n\n추천 준비: ${primary.recommendations
            .map((r) => r.title)
            .join(', ')}`;
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(text);
            } else {
              const ta = document.createElement('textarea');
              ta.value = text;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            }
            copyBtn.textContent = '결과를 복사했어요';
            setTimeout(() => {
              copyBtn.textContent = '결과 요약 복사';
            }, 2000);
          } catch (_) {}
        });
      }

      function restartQuiz() {
        answers = [];
        currentIndex = 0;
        step = 'start';
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function render() {
        if (step === 'start') renderStart();
        else if (step === 'question') renderQuestion();
        else renderResult();
      }

      render();
    </script>
  </body>
</html>